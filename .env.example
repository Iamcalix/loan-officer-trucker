# Wanway / IoP Open API credentials — SAME values you use for smart-collector.
WANWAY_APPID=your-account-name
WANWAY_API_KEY=your-secret-key
# Optional overrides:
# WANWAY_API_BASE=https://open.iopgps.com
# WANWAY_TAKE_SUB=true          # include devices under sub-accounts (default on)
# WANWAY_ACCOUNT_ID=            # restrict to one account id (default: whole org)

# Server
PORT=3000
OFFLINE_AFTER_MIN=25           # signal older than this = "offline"
LIVE_CACHE_MS=15000            # server-side cache for the bulk live snapshot
HTTP_TIMEOUT_MS=15000
# OFFICERS_FILE=./data/officers.json   # IMEI -> officer name/phone/area map

# Office geofence — when an officer is within radius, they read "At office".
OFFICE_NAME=Head Office
OFFICE_LAT=-6.8901105
OFFICE_LNG=39.2924842
OFFICE_RADIUS_M=120

# Visit / stop detection
CUSTOMER_RADIUS_M=150          # officer within this of a customer bike = "with" them
STOP_RADIUS_M=80              # a stop = fixes staying inside this radius…
STOP_MIN_MINUTES=5           # …for at least this long
STOP_SPEED_KMH=4
MOVING_SPEED_KMH=6            # live fix above this = "Moving", else "Stopped"
